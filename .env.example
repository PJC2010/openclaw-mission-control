# Mission Control — environment template.
#
# Copy to one of:
#   - /etc/mission-control/env   (production; root:missionctl 0640; referenced by
#     the systemd units via EnvironmentFile=. See docs/phase-0-runbook.md.)
#   - ./.env                     (local development; git-ignored)
#
# Secrets MUST NOT live in the repo (spec §12 S5). Use long random values:
#   openssl rand -hex 32
# Keep passwords alphanumeric — they are interpolated into SQL by the
# first-boot role script (deploy/postgres/initdb/01-roles.sh) and into URLs.

# ── Database bootstrap (read by the postgres container on FIRST init only) ──
MC_DB_SUPERUSER_PASSWORD=change-me
MC_DB_MIGRATE_PASSWORD=change-me
MC_DB_APP_PASSWORD=change-me
MC_DB_READONLY_PASSWORD=change-me

# ── API process ──
# C2: the API binds loopback only. Any non-loopback value refuses to start.
MC_BIND_HOST=127.0.0.1
MC_BIND_PORT=8100

# Runtime (app) role — used by request handlers. No DDL; no UPDATE/DELETE on audit_log.
MC_DATABASE_URL=postgresql+psycopg://mc_app:change-me@127.0.0.1:5432/mission_control
# Migration role — owns the schema; used only by `alembic upgrade` (§12 S4).
MC_MIGRATE_DATABASE_URL=postgresql+psycopg://mc_migrate:change-me@127.0.0.1:5432/mission_control

# ── Tailscale identity verification (§11.3 layer 3) ──
MC_TAILSCALE_BIN=tailscale
MC_WHOIS_TIMEOUT_S=2.0
MC_WHOIS_CACHE_TTL_S=60
# Optional hardening: pin the MagicDNS name Serve fronts this app with, e.g.
# vps-hostname.tailnet-name.ts.net — requests whose X-Forwarded-Host differs are rejected.
# Leave empty to skip the check.
MC_EXPECTED_FORWARDED_HOST=

# Which local UIDs may present operator identity (§11.3 layer 1).
# `tailscale serve` proxies as root, so the default is root only. This is
# load-bearing: the agent runtimes run on this same host, and Serve injects
# no secret, so without this check any local process could set the identity
# headers itself and approve its own requests (C4).
#
# THEREFORE: the agent runtimes MUST NOT run as a UID listed here. Running
# an agent as root re-opens the hole.
MC_OPERATOR_PEER_UIDS=0
# Reject when the peer UID cannot be determined. Set false only on a host
# where no untrusted local code runs at all.
MC_REQUIRE_PEER_UID=true

MC_LOG_LEVEL=INFO

# ── Phase 1: adapters (§6) ──
# OpenClaw gateway WS (loopback). Empty URL disables the adapter.
MC_OPENCLAW_URL=ws://127.0.0.1:18789
# Gateway token (gateway.auth.mode: token) — scope the client to operator.read.
MC_OPENCLAW_TOKEN=
MC_OPENCLAW_POLL_INTERVAL_S=3.0

# Hermes Agent home (the daemon user's ~/.hermes). Empty disables the adapter.
# The API's systemd unit must bind this path read-only (BindReadOnlyPaths).
MC_HERMES_HOME=
MC_HERMES_POLL_INTERVAL_S=5.0
# Fail-loud schema guard (§6.2): verified against hermes-agent 0.20.4.
MC_HERMES_EXPECTED_SCHEMA_VERSION=26
